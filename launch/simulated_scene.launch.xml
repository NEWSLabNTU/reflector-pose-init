<?xml version="1.0"?>
<!--
  Desk test: synthetic VLP-32C scans into the initializer, no hardware and no
  localization stack. dry_run publishes the composed pose instead of calling the
  service, so the whole path can be exercised standalone.
-->
<launch>
  <arg name="scene" default="board"/>            <!-- board | distractors | two_boards -->
  <arg name="range_m" default="6.0"/>
  <arg name="yaw_deg" default="0.0"/>
  <arg name="blooming" default="false"/>
  <arg name="dry_run" default="true"/>
  <arg name="rviz" default="false"/>

  <node pkg="golfcart_board_initializer" exec="board_scene_publisher"
        name="board_scene_publisher" output="screen">
    <param name="scene" value="$(var scene)"/>
    <param name="range_m" value="$(var range_m)"/>
    <param name="yaw_deg" value="$(var yaw_deg)"/>
    <param name="blooming" value="$(var blooming)"/>
  </node>

  <include file="$(find-pkg-share golfcart_board_initializer)/launch/board_initializer.launch.xml">
    <arg name="dry_run" value="$(var dry_run)"/>
  </include>
  <node pkg="rviz2" exec="rviz2" name="rviz2" if="$(var rviz)"
        args="-d $(find-pkg-share golfcart_board_initializer)/rviz/board_initializer.rviz"/>
</launch>
